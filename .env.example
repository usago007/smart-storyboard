# ===========================================
# V1 前端演示模式（推荐）
# ===========================================
# mock — 纯前端 mock 服务，不依赖任何后端
# remote — 第二阶段接入真实后端时切换（暂未实现）
NEXT_PUBLIC_DATA_MODE=mock

# ===========================================
# V1 遗留兼容（仅旧 _api/ 目录需要）
# ===========================================
# 旧 API 路由已移至 src/app/_api/，不参与当前主链路构建。
# 以下变量仅当需要恢复旧 API 路由时使用。
DEMO_MODE=true
# PGDATABASE_URL=postgresql://user:password@localhost:5432/storyboard_db
# COZE_WORKLOAD_IDENTITY_API_KEY=your-api-key
# COZE_INTEGRATION_MODEL_BASE_URL=https://your-llm-api
# COZE_INTEGRATION_BASE_URL=https://your-image-api
# COZE_BUCKET_ENDPOINT_URL=
# COZE_BUCKET_NAME=
